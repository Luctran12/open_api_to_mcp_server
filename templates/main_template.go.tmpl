package main

import (
	"encoding/json"
	"fmt"
	"log"
	"open_api_to_mcp_server/pkg/config"
	"open_api_to_mcp_server/pkg/openapi"
	"open_api_to_mcp_server/pkg/server"
	"os"
	"path/filepath"
)

func main() {
	// 🧾 Tạo file log trong cùng thư mục .exe ver 3:15
	execPath, _ := os.Executable()
	logDir := filepath.Dir(execPath)
	logFile := filepath.Join(logDir, "mcp_error.log")

	f, err := os.OpenFile(logFile, os.O_CREATE|os.O_WRONLY|os.O_APPEND, 0644)
	if err != nil {
		fmt.Println("❌ Cannot create log file:", err)
		os.Exit(1)
	}
	defer f.Close()
	log.SetOutput(f)

	log.Println("🟢 MCP executable started")

	specJSON := `{{ .SpecJSON }}`
	var spec openapi.Spec
	if err := json.Unmarshal([]byte(specJSON), &spec); err != nil {
		log.Printf("❌ Failed to parse spec: %v\n", err)
		fmt.Println("❌ Failed to parse spec. Check mcp_error.log for details.")
		os.Exit(1)
	}

	// ⚙️ Tạo MCP server
	cfg := &config.Config{
		Server: config.ServerConfig{
			Name:    "openapi-client",
			Version: "1.0.0",
		},
	}
	mcpServer := server.NewMCPServer(cfg)
	if mcpServer == nil {
		log.Println("❌ Failed to create MCP server (nil returned)")
		fmt.Println("❌ Failed to create MCP server. Check mcp_error.log for details.")
		os.Exit(1)
	}

	// 🧩 Generate tools
	toolDefinitions, err := openapi.NewGenerator().Generate(&spec)
	if err != nil {
		log.Printf("❌ Error generating tools: %v\n", err)
		fmt.Println("❌ Error generating tools. Check mcp_error.log for details.")
		os.Exit(1)
	}
	log.Printf("✅ Generated %d tools from OpenAPI spec\n", len(toolDefinitions))

	for _, tool := range toolDefinitions {
		mcpServer.AddTool(tool)
		log.Printf("📋 Added tool: %s\n", tool.Name)
		
	}

	log.Println("🚀 Starting MCP server via stdio ...")

	if err := mcpServer.ServeStdio(); err != nil {
		log.Printf("❌ Stdio server error: %v\n", err)
		fmt.Println("❌ MCP server failed. Check mcp_error.log for details.")
		os.Exit(1)
	}
}
